{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"game_maps",
		"game_modes",
		"score_weights",
		"ignore_invites_period",
		"invites_spam_period",
		"rank_tiers"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"game_maps": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"label",
					"team_spawn_points"
				],
				"properties": {
					"label": {
						"type": "string",
						"minLength": 1
					},
					"team_spawn_points": {
						"type": "array",
						"minItems": 2,
						"items": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "array",
								"minItems": 4,
								"maxItems": 4,
								"items": {
									"type": "number"
								}
							}
						}
					}
				}
			}
		},
		"game_modes": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"label",
					"min_players_per_team",
					"maps_allowed"
				],
				"properties": {
					"label": {
						"type": "string",
						"minLength": 1
					},
					"min_players_per_team": {
						"type": "integer",
						"minimum": 1
					},
					"maps_allowed": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"rounds": {
						"type": "integer",
						"minimum": 3,
						"not": {
							"multipleOf": 2
						}
					},
					"round_time": {
						"type": "integer",
						"minimum": 10
					},
					"pre_and_post_round_time": {
						"type": "integer",
						"minimum": 3
					}
				}
			}
		},
		"score_weights": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"win",
				"loss",
				"kill",
				"assist",
				"death"
			],
			"properties": {
				"win": {
					"type": "number"
				},
				"loss": {
					"type": "number"
				},
				"kill": {
					"type": "number"
				},
				"assist": {
					"type": "number"
				},
				"death": {
					"type": "number"
				}
			}
		},
		"ignore_invites_period": {
			"type": "number",
			"minimum": 0
		},
		"invites_spam_period": {
			"type": "number",
			"minimum": 0
		},
		"rank_tiers": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"label",
					"min_score",
					"className"
				],
				"properties": {
					"label": {
						"type": "string",
						"minLength": 1
					},
					"min_score": {
						"type": "number"
					},
					"className": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		}
	}
}
